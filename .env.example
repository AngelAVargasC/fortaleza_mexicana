# Copia este archivo a .env.local y ajusta los valores.

# PostgreSQL. En Railway: referencia ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://fm:fm_local@localhost:5439/fortaleza

# Opcional: conexiones maximas del pool por instancia (10 por defecto).
# DB_POOL_MAX=10

# Opcional: dominio fijo para los QR de /qr.
# NEXT_PUBLIC_SITIO_URL=https://fortalezamexicana.mx

# Opcional: Microsoft Clarity (ID del proyecto en clarity.microsoft.com).
# Se lee en el build: al cambiarla, volver a desplegar.
# NEXT_PUBLIC_CLARITY_ID=
